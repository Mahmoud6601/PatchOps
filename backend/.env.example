# Copy to /etc/patching-platform/patching.env and fill with generated values.
# Do not commit the populated file.
SECRET_KEY=
DATABASE_URL=

PROJECT_NAME=Enterprise OS Patching & Update Platform
API_V1_STR=/api
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENABLE_API_DOCS=false
CORS_ORIGINS=[]

# Use the HTTPS hostname covered by the AWX certificate.
AWX_URL=
AWX_TOKEN=
AWX_VERIFY_SSL=true
# Optional PEM CA bundle for an internal, certificate-validated AWX endpoint.
AWX_CA_BUNDLE=
# Must match the inventory selected on each AWX job template.
# AWX_INVENTORY_ID=12
AWX_DISCOVERY_TEMPLATE_NAME=Template-OS-Discovery
AWX_SECURITY_TEMPLATE_NAME=Template-Security-Patching
AWX_REGULAR_TEMPLATE_NAME=Template-Regular-Patching
AWX_MAJOR_UPGRADE_TEMPLATE_NAME=Template-Major-OS-Upgrade
# Select a Windows Machine credential per server from Server Management.
# The platform stores only its AWX ID, never its password.
AWX_WINDOWS_WINRM_TRANSPORT=ntlm
# Use `validate` with a certificate trusted by the AWX execution environment.
# Use `ignore` only for an internal self-signed WinRM HTTPS certificate.
AWX_WINDOWS_WINRM_SERVER_CERT_VALIDATION=validate
AWX_POLL_INTERVAL_SECONDS=5
AWX_JOB_TIMEOUT_SECONDS=86400
DISCOVERY_MAX_AGE_HOURS=24
WORKER_POLL_INTERVAL_SECONDS=5
